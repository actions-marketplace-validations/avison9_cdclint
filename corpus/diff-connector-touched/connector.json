{
  "name": "refuseradar-postgres-source",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "topic.prefix": "rr",
    "table.include.list": "public.report_validations",
    "column.include.list": "public.report_validations\\.(id|report_id|validator_user_id|clearance_event_id|response|assigned_at|responded_at)",
    "snapshot.mode": "initial",
    "_note": "response_distance_m is deliberately not captured: it is a per-response measurement the warehouse does not need."
  }
}